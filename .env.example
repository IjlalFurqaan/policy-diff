# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production: a Neon connection string. Anything hosted on neon.tech is driven
# by @neondatabase/serverless over HTTP; every other host falls back to the
# plain postgres driver (that is what `npm run db:local` serves).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/policydiff?sslmode=require"

# Force a driver instead of inferring it from the host. auto | neon | postgres
# DB_DRIVER="auto"

# ---------------------------------------------------------------------------
# Crawler
# ---------------------------------------------------------------------------
# Shared secret for /api/cron/crawl. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`; a plain `x-cron-secret` header works too.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Appended to the User-Agent so site owners have somewhere to complain.
CRAWLER_CONTACT_URL="https://policy-diff.example.com/about/crawler"

# Allow the crawler to hit localhost. Development only — this is what makes the
# fake-ToS fixture reachable, and it must stay off in production.
CRAWL_ALLOW_LOCALHOST="false"

# ---------------------------------------------------------------------------
# Summarization
# ---------------------------------------------------------------------------
# Without a key the pipeline falls back to an offline heuristic summarizer and
# every change it produces is flagged for review instead of published.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Unset in development: subscriptions are still stored, sending is skipped.
RESEND_API_KEY=""
RESEND_FROM="Policy Diff <alerts@policy-diff.example.com>"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
